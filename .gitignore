dist/
build/
*.tar.gz
*.zip
exported_images/

# Package Dependencies
node_modules/
.bun/
.venv/
venv/
__pycache__/
*.pyc

# IDE & Editor Settings
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Intermediate Scan Output
ocr_output.json
ocr_output_*.json
vulnerabilities*.csv
report*.csv
