# LLM Models & Heavy Shards (~28GB to ~60GB)
models/
models/*
**/models/
*jina*
*.safetensors
*.bin
*.pt
*.onnx

# Microservice Databases & Storage Engines
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite*
qdrant_storage/
**/qdrant_storage/
zips/
**/zips/
scan-res.json
**/reports/*.json

# Sensitive Credentials & Local API Keys
.env
.env.*
!.env.example
.env.githubpat
*.token
*.pem
*.key

# Test Repositories & Mock Data
testing repos/
"testing repos /"
testing repos */
Mock_Data/
ps1_mock2/
Software_*/

# Local Caches & Sessions
.qbit/
.opencodereview/
.cache/
*.log
/tmp/vllm*.log
/tmp/qbit_cockpit.log

